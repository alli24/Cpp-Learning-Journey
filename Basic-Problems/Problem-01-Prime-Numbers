

// Define an enum to represent Prime and NotPrime numbers.
enum enPrimeNotPrime { Prime = 1, NotPrime = 2 };

// Read a positive number from the user.
int ReadPositveNumber(string Message) 
{
int Number = 0;
// Keep asking the user until entering a positive number.
do
{
    cout << Message << endl;
    cin >> Number;

} while (Number <= 0);

// Return the positive number.
return Number;
}

// Check if the given number is Prime or NotPrime.

enPrimeNotPrime CheckPrimeNumber(int number) 
{
// Calculate half of the given number.

int M = round(number / 2);

// Loop from 2 to half of the number.
for (size_t i = 2; i <= M; i++)
{
    // Check if the number is divisible by i.
    if (number % i == 0)
        return PrimeNotPrime::NotPrime;
}

// If no divisor is found,
return Prime.
return PrimeNotPrime::Prime;
}

// Print all Prime numbers from 1 to the given number.
void PrintPrimeNumber(int number)
{
cout << "\n";
cout << "Pirme Numbers From " << 1 << " To " << number; cout << " Are : " << endl;

// Loop through all numbers from 1 to the given number.
for (int i = 1; i <= number; i++)
{
    // Check if the current number is Prime.
    if (CheckPrimeNumber(i) == PrimeNotPrime::Prime)
    {
        // Print the Prime number.
        cout << i << endl;
    }
}
